<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <RepositoryUrl>https://github.com/Wsm2110/Faster.Modulith</RepositoryUrl>
    <PackageId>Faster.Modulith.Analyzers</PackageId>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <Version>1.1.3</Version>
    <Description>Building unbreakable monoliths with rosyln sourcegenerators</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Wiljan Ruizendaal</Authors>
    <Company>Faster Framework</Company>
    <Description>
      A high-performance framework for building unbreakable modular monoliths in .NET.
      Uses Roslyn Source Generators to enforce strict architectural boundaries and eliminate dispatching boilerplate at compile-time.
      Ensuring the final feature is implemented as seamlessly as the first.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="4.12.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contracts\Faster.Modulith.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="bin\Release\netstandard2.0\\Faster.Modulith.Analyzers.dll" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Remove="bin\Release\netstandard2.0\\Faster.Modulith.Contracts.dll" />
    <None Include="$(OutputPath)\Faster.Modulith.Contracts.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
</Project>